# docker compose settings — copy to ".env" next to docker-compose.yml.
# Everything is optional: with no .env the stack serves http://localhost.

# Public address Caddy serves. ":80" = plain HTTP on port 80. A domain name
# (e.g. nexops.example.com, DNS pointing at this host) = automatic HTTPS via
# Let's Encrypt — then ALSO set COOKIE_SECURE=1.
SITE_ADDRESS=:80
COOKIE_SECURE=0
# Host ports Caddy binds.
HTTP_PORT=80
HTTPS_PORT=443

# JWT signing secret. Blank = generated once and stored on the backend volume.
# To set one: python -c "import secrets; print(secrets.token_hex(32))"
NEXOPS_JWT_SECRET=

# Password for all seeded demo accounts (applied on FIRST start, when the DB is
# seeded). Blank = the demo default "nexops123". CHANGE IT for anything public.
NEXOPS_SEED_PASSWORD=

# Optional ARIA LLM keys (blank = deterministic offline answers).
GEMINI_API_KEY=
GROQ_API_KEY=
