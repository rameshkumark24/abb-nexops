# NexOps backend — environment configuration.
# Copy to ".env" (or export these) for any non-local / production run.
# Every value has a safe localhost default, so the demo runs with NOTHING set.
# Optional settings are COMMENTED OUT on purpose: uncomment only what you set.

# --- Auth (SET THESE IN PRODUCTION) ---
# JWT signing secret (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# If unset, a random per-deployment secret is generated and persisted to
# NEXOPS_JWT_SECRET_FILE (default: nexops-backend/.jwt_secret, gitignored).
# NEXOPS_JWT_SECRET=
# NEXOPS_JWT_SECRET_FILE=/data/.jwt_secret
# Send the session/CSRF cookies only over HTTPS (set to 1 behind TLS).
# COOKIE_SECURE=1
# Trust X-Forwarded-For for login rate-limiting (set to 1 behind a trusted proxy
# that is NOT uvicorn --proxy-headers aware; see README "Deployment").
# TRUST_PROXY=1

# Password for every SEEDED demo account (applied when the DB is first seeded).
# Unset/blank -> the demo default "nexops123".
# NEXOPS_SEED_PASSWORD=

# --- ARIA LLM (optional) ---
# If BOTH keys are unset, ARIA serves its deterministic OFFLINE template.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# ARIA_LLM_TIMEOUT=8

# --- MQTT telemetry feed ---
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_TOPIC=nexops/refinery/telemetry/#
# MQTT_ENABLED=0          # run the API with no broker at all (no live feed)
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=1

# --- Server / storage ---
WS_HOST=0.0.0.0
WS_PORT=8000
# SQLite by default; any SQLAlchemy URL works, e.g.
#   postgresql://user:pass@host:5432/nexops   (postgres:// is accepted too)
DATABASE_URL=sqlite:///nexops.db
# Allowed browser origins for DIRECT (non-proxied) API calls, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
