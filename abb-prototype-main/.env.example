# NexOps frontend — environment configuration.
# Copy to ".env.local". All values have working localhost defaults.

# The backend origin the Next.js same-origin proxy forwards /api/* (REST AND the
# /api/ws WebSocket) to. Keeps the httpOnly auth cookie first-party and means
# the browser never talks to the backend directly.
# NOTE: read at BUILD time (`next build`) — rebuild after changing it.
# Default: http://localhost:8000
BACKEND_ORIGIN=http://localhost:8000

# Live-feed WebSocket. Default: same-origin "/api/ws" (proxied by Next; ws/wss
# follows the page's http/https). Only set this to bypass the proxy, e.g.
#   NEXT_PUBLIC_WS_URL=wss://api.example.com/ws
# NEXT_PUBLIC_WS_URL=/api/ws

# Optional: override the same-origin API base (default "/api" via the proxy).
# Leave unset unless you intentionally bypass the proxy.
# NEXT_PUBLIC_API_BASE=/api

# Frontend-only demo mode with synthetic telemetry (no backend WebSocket).
# NEXT_PUBLIC_USE_MOCK=1
